{
  "app_key": "aurora.spacedrag",
  "bindings": {
    "/actions/spacedrag": {
      "sources": [
        {
          "inputs": {
            "click": {
              "output": "/actions/spacedrag/in/drag_left"
            }
          },
          "mode": "button",
          "path": "/user/hand/left/input/grip",
          "parameters": {
            "click_activate_threshold": "0.8",
            "click_deactivate_threshold": "0.7",
            "force_input": "force"
          }
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/spacedrag/in/drag_right"
            }
          },
          "mode": "button",
          "path": "/user/hand/right/input/grip",
          "parameters": {
            "click_activate_threshold": "0.8",
            "click_deactivate_threshold": "0.7",
            "force_input": "force"
          }
        }
      ]
    }
  },
  "controller_type": "knuckles",
  "description": "Hold the grip to drag the play space.",
  "name": "Aurora Space Drag (hold grip)"
}
